BEGIN:VEVENT
SUMMARY:Kammermusik-Festival: KLANGBILDER zwischen TIFLIS und INGOLSTADT -
  STIMMFÜHRER-QUINTETT DER KAMMERPHILHARMONIE INGOLSTADT
DTSTART;TZID=Europe/Berlin:20261004T210000
