UID:gr-ndungsberatung-im-existenzgr-nder-zentrum-egz-in-ingolstadt-20260105-1600@ifg-plattform.de
DTSTAMP:20260719T065608Z
DTSTART;TZID=Europe/Berlin:20260105T170000
